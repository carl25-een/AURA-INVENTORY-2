# Copy this file to ".env" for local use, or set the same variables in your
# hosting provider's dashboard. The server also reads real environment
# variables, which take precedence.

# Port the server listens on (hosting providers set this automatically).
PORT=3000

# Optional staff PIN. When set, adding/editing/deleting products and
# adjusting stock require this PIN (the app will prompt for it).
# Leave empty to disable.
STAFF_PIN=
